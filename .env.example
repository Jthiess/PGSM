# ==============================================================
# PGSM + Game Panel — Environment Configuration
# Copy this file to .env and fill in your values.
# ==============================================================


# ==============================================================
# Flask
# ==============================================================
Flask_Port=5000
# Accepts SECRET_KEY or Secret_Key. If unset, a random key is generated and
# persisted to instance/.flask_secret.
Secret_Key=changeme-replace-with-secrets.token_hex-output

# Session/cookie hardening. SESSION_COOKIE_SECURE defaults to true (HTTPS only);
# set to false ONLY for local plain-HTTP development.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_LIFETIME_SECONDS=43200

# Token for internal-only API calls (whitelist sync). If unset, a random token
# is generated and persisted to instance/.internal_token (no longer derived
# from Secret_Key). Set explicitly only if the panel and API run separately.
# INTERNAL_API_TOKEN=

# Comma-separated allowed origins for SocketIO (console). Leave unset for
# same-origin only. '*' is rejected for cookie-authenticated sockets.
# CORS_ORIGINS=


# ==============================================================
# Admin Authentication
# A single login unlocks both the Game Panel admin and PGSM.
# ==============================================================

# Full admin password. NO DEFAULT: if this is unset AND neither LDAP nor
# Authentik is configured, password login is DISABLED (fail closed). Set a
# strong value to enable password login.
ADMIN_PASSWORD=changeme

# Optional: a second password that only allows editing messages/rules
MESSAGES_PASSWORD=


# ==============================================================
# Game Panel — PostgreSQL
# Used for the public-facing server cards and whitelist data.
# ==============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gamepanel
DB_USER=postgres
DB_PASSWORD=changeme

# PostgreSQL schema names (defaults work for a fresh database)
DB_SCHEMA=public
DB_SERVERS_SCHEMA=servers


# ==============================================================
# Game Panel — Whitelist
# ==============================================================

# How often to re-sync approved whitelist entries to PGSM servers (minutes)
WHITELIST_SYNC_INTERVAL=60

# Limit whitelist submissions per Discord username (0 = unlimited)
MAX_REQUESTS_PER_DISCORD=1

# Optional: ntfy.sh topic for new whitelist submission notifications
NTFY_TOPIC=

# Optional: Discord guild membership check before accepting submissions
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=


# ==============================================================
# Game Panel — File Paths
# Paths are relative to the project root (where main.py lives).
# ==============================================================

# Directory containing messages.txt and rules.md
PANEL_DATA_DIR=data

# Directory where pack icon images are stored and served from
PANEL_PACK_ICONS_DIR=app/static/images/packicons


# ==============================================================
# Proxmox API
# ==============================================================
Proxmox_Host=10.0.0.3
Proxmox_Port=8006
Proxmox_Username=root@pam
Proxmox_Password=changeme
# Preferred over the root password: a scoped API token (both required to use).
# Proxmox_Token_Name=root@pam!pgsm
# Proxmox_Token_Value=
# TLS verification defaults ON. Set to false ONLY for a self-signed cert on a
# trusted management network.
Proxmox_Verify_SSL=true
# Proxmox_Timeout=30


# ==============================================================
# PGSM — Networking
# ==============================================================

# VLAN subnet assigned to game server containers
PGSM_VLAN_Subnet=172.16.0.0/24
PGSM_VLAN_Gateway=172.16.0.1

# First IP PGSM may assign; leave lower IPs free for nodes/router/controller
PGSM_VLAN_IP_Start=172.16.0.10


# ==============================================================
# PGSM — Proxmox LXC
# ==============================================================

# LXC base template (must exist in Proxmox storage)
PGSM_LXC_Template=kestrel:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst


# ==============================================================
# PGSM — SSH
# ==============================================================

# RSA keypair used to SSH into game server containers.
# Generated automatically on first run if the file does not exist.
SSH_Key_Path=keys/pgsm_rsa


# ==============================================================
# PGSM — Nginx
# ==============================================================

# Directory where per-server stream configs are written.
# Requires: stream { include /etc/nginx/stream.d/*.conf; } in nginx.conf
Nginx_Conf_Dir=/etc/nginx/stream.d


# ==============================================================
# PGSM — Logging
# ==============================================================

# Python logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# Set to DEBUG to see every SSH command and Proxmox API call.
LOG_LEVEL=INFO

# Path to the rotating log file (relative to project root).
# Leave empty to disable file logging (console/stdout only).
LOG_FILE=logs/pgsm.log

# Max size of each log file before rotation (bytes). Default: 10 MB.
LOG_MAX_BYTES=10485760

# Number of rotated log files to keep. Default: 5.
LOG_BACKUP_COUNT=5


# ==============================================================
# PGSM — Minecraft version manifest
# ==============================================================
Minecraft_Manifest_Url=https://piston-meta.mojang.com/mc/game/version_manifest.json


# ==============================================================
# PGSM — Server creation defaults
# Pre-filled values in the new server wizard. All optional.
# ==============================================================
Server_Default_Disk_GB=20
Server_Default_Cores=8
Server_Default_Memory_MB=4096
Server_Default_Game_Port=25565
Server_Default_Render_Distance=12
Server_Default_Spawn_Protection=0
Server_Default_Difficulty=normal
Server_Default_Server_Type=vanilla
Server_Default_HA_Enabled=true
